<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#002244">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvAliasServicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/servicio_alias"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvUsuarioCifrado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/usuario_cifrado"
            android:textColor="#D0D8E0"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tvTokenCifrado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/token_cifrado"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvAlgoritmoUsado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aes_256_gcm"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#001122"
            android:padding="3dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>